# Heimdall laptop secrets template.
#
#   cp .env.example .env        # .env is git-ignored; never commit it
#   $EDITOR .env                # fill in your own values
#   make secrets-local          # writes one 0600 file per key into ~/heimdall/secrets
#
# `make secrets-local` runs `heimdall secrets-sync`. It reads only the keys below, writes each one to
# a file in the secrets directory, and never prints a value. Override the paths with
# `make secrets-local ENV_FILE=/path/.env SECRETS_DIR=/path/secrets`.
#
# The server never reads this file. It reads the secret files, by the names set in heimdall.toml.

# Model provider for the agents and the memory extractor  ->  openrouter_api_key
OPENROUTER_API_KEY=

# Jira Cloud account and API token  ->  jira_email, jira_api_token
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=
ATLASSIAN_API_KEY=

# GitHub App that reads PRs and posts checks  ->  github_app_id, github_app_installation_id
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Path to the App's private key (.pem). The file's bytes are copied  ->  github_app_private_key
GITHUB_APP_PRIVATE_KEY_PATH=

# Not in this file, on purpose:
#   switch_registration_token
#       heimdall admin secret set --config <toml> --secrets-dir <dir> --name switch_registration_token
#       (hidden prompt; the value is never an argument)
#   switch_api_key
#       written for you by: heimdall switch-register --config <toml> --name <coordinator-name>
#   postgres_password, database_url, agent_token_<name>
#       generated fresh, once, before the first deploy (a second run replaces them):
#       go run ./cmd/heimdall secrets-sync --env .env --out <dir> --bootstrap-generated
