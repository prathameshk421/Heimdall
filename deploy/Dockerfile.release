ARG RUNTIME_IMAGE=alpine:3.24.3
FROM ${RUNTIME_IMAGE}
RUN addgroup -S -g 65532 heimdall && adduser -S -D -H -u 65532 -G heimdall heimdall
COPY --chown=65532:65532 bin/heimdall-server /usr/local/bin/heimdall-server
RUN mkdir -p /var/lib/heimdall && chown 65532:65532 /var/lib/heimdall
WORKDIR /var/lib/heimdall
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD printf 'GET /healthz HTTP/1.0\r\nHost: localhost\r\n\r\n' | nc -w 3 127.0.0.1 8080 | grep -q '"status":"ok"' || exit 1
ENTRYPOINT ["/usr/local/bin/heimdall-server"]
