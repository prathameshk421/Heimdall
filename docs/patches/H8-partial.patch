+
+// maxLeadLines bounds the leads one task shows.
+const maxLeadLines = 60
+
+// leadsOn are the check results of the newest checks.reported on head, as "file:line check/rule: message", then the
+// checks that could not run.
+func leadsOn(head id.SHA, events []change.Event) []string {
+	if head == "" {
+		return nil
+	}
+	for i := len(events) - 1; i >= 0; i-- {
+		if events[i].Type != change.EventChecksReported {
+			continue
+		}
+		p, err := change.Decode(events[i])
+		if err != nil {
+			return nil
+		}
+		r, ok := p.(change.ChecksReported)
+		if !ok || r.Head != head {
+			continue
+		}
+		var out []string
+		for _, res := range r.Results {
+			out = append(out, fmt.Sprintf("%s:%d %s/%s: %s", res.File, res.Lines[0], res.Check, res.Rule, res.Message))
+		}
+		for _, e := range r.Errors {
+			out = append(out, fmt.Sprintf("check %s could not run: %s", e.Check, e.Reason))
+		}
+		if r.More > 0 {
+			out = append(out, fmt.Sprintf("... %d more results", r.More))
+		}
+		if len(out) > maxLeadLines {
+			out = append(out[:maxLeadLines], fmt.Sprintf("... %d more lines", len(out)-maxLeadLines))
+		}
+		return out
+	}
+	return nil
+}
diff --git a/internal/app/effects/checks.go b/internal/app/effects/checks.go
new file mode 100644
index 0000000..53fe72a
--- /dev/null
+++ b/internal/app/effects/checks.go
@@ -0,0 +1,131 @@
+package effects
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/domain/change"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/domain/id"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/domain/sarif"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/ports"
+)
+
+// checkTimeout bounds one profile check run.
+const checkTimeout = 5 * time.Minute
+
+// ChecksDeps are the dependencies of Checks.
+type ChecksDeps struct {
+	Source   Source
+	Sandbox  ports.Sandbox
+	Profiles ports.ProfileStore
+	Ingest   Ingest
+	IDs      ports.IDs
+	Clock    ports.Clock
+}
+
+// Checks performs run_checks effects (HARNESS_DESIGN B7): it runs each named check of the repository's promoted profile
+// on the pull request head, and on the base too when the check compares against it, and records checks.reported with the
+// results the head added. A check that cannot run is an entry of errors; it never fails the job, because a broken check
+// must not stall the review.
+type Checks struct {
+	deps ChecksDeps
+}
+
+// NewChecks builds the executor, or refuses when a dependency is missing.
+func NewChecks(d ChecksDeps) (Checks, error) {
+	if d.Source == nil || d.Sandbox == nil || d.Profiles == nil || d.Ingest == nil || d.IDs == nil || d.Clock == nil {
+		return Checks{}, fmt.Errorf("run_checks executor: missing source, sandbox, profiles, ingest, ids or clock")
+	}
+	return Checks{deps: d}, nil
+}
+
+// Execute runs the checks and records the report.
+func (c Checks) Execute(ctx context.Context, fx change.Effect) error {
+	if fx.Kind != change.EffectRunChecks {
+		return failf(nil, "run_checks executor: effect %s has kind %s", fx.Key, fx.Kind)
+	}
+	p, err := change.DecodeRunChecksPayload(fx.Payload)
+	if err != nil {
+		return failf(err, "run_checks effect %s: payload refused: %v", fx.Key, err)
+	}
+	profile, ok, err := c.deps.Profiles.ActiveProfile(ctx, string(p.Repo))
+	if err != nil {
+		return failf(err, "run_checks %s: read the profile", p.Change)
+	}
+	if !ok {
+		return failf(nil, "run_checks %s: the repository has no promoted profile", p.Change)
+	}
+	if err := c.deps.Source.Fetch(ctx, p.Repo, p.Head); err != nil {
+		return failf(err, "run_checks %s: fetch head source", p.Change)
+	}
+	report := change.ChecksReported{Head: p.Head, Results: []sarif.Result{}, Errors: []change.CheckError{}}
+	var all []sarif.Result
+	for _, checkID := range p.CheckIDs {
+		row, found := checkRow(profile.Spec.Checks, checkID)
+		if !found {
+			report.Errors = append(report.Errors, change.CheckError{Check: checkID, Reason: "the profile has no such check"})
+			continue
+		}
+		results, err := c.runOne(ctx, p, row)
+		if err != nil {
+			report.Errors = append(report.Errors, change.CheckError{Check: checkID, Reason: err.Error()})
+			continue
+		}
+		all = append(all, results...)
+	}
+	if len(all) > change.MaxCheckResults {
+		report.More = len(all) - change.MaxCheckResults
+		all = all[:change.MaxCheckResults]
+	}
+	report.Results = append(report.Results, all...)
+	ev, err := newFact(c.deps.IDs, c.deps.Clock, change.EventChecksReported, change.Actor{Kind: change.ActorSystem, ID: "heimdall"}, report)
+	if err != nil {
+		return failf(err, "run_checks %s: build event", p.Change)
+	}
+	if err := c.deps.Ingest.Ingest(ctx, p.Change, []change.Event{ev}); err != nil {
+		return failf(err, "run_checks %s: ingest checks.reported", p.Change)
+	}
+	return nil
+}
+
+func checkRow(rows []ports.ProfileCheck, id string) (ports.ProfileCheck, bool) {
+	for _, r := range rows {
+		if r.ID == id {
+			return r, true
+		}
+	}
+	return ports.ProfileCheck{}, false
+}
+
+// runOne runs one check on the head and, with a baseline, on the base, and returns what the head added.
+func (c Checks) runOne(ctx context.Context, p change.RunChecksPayload, row ports.ProfileCheck) ([]sarif.Result, error) {
+	head, err := c.runAt(ctx, p, row, p.Head, "")
+	if err != nil {
+		return nil, err
+	}
+	if !row.Baseline || p.Base == "" {
+		return head, nil
+	}
+	if err := c.deps.Source.Fetch(ctx, p.Repo, p.Base); err != nil {
+		return nil, fmt.Errorf("fetch base source: %w", ports.ErrUnavailable)
+	}
+	base, err := c.runAt(ctx, p, row, p.Base, p.Head)
+	if err != nil {
+		return nil, err
+	}
+	return sarif.New(base, head), nil
+}
+
+func (c Checks) runAt(ctx context.Context, p change.RunChecksPayload, row ports.ProfileCheck, sha, head id.SHA) ([]sarif.Result, error) {
+	res, err := c.deps.Sandbox.Run(ctx, ports.SandboxJob{Kind: ports.SandboxCheck, CheckID: row.ID, Repo: p.Repo, SHA: sha,
+		Change: p.Change, Head: head, Timeout: checkTimeout})
+	if err != nil {
+		return nil, fmt.Errorf("the check did not run: %w", ports.ErrUnavailable)
+	}
+	results, err := sarif.Parse(res.Sarif, row.ID, row.Lens)
+	if err != nil {
+		return nil, fmt.Errorf("the check wrote no valid SARIF")
+	}
+	return results, nil
+}
diff --git a/internal/app/effects/checks_test.go b/internal/app/effects/checks_test.go
new file mode 100644
index 0000000..c6aa5a4
--- /dev/null
+++ b/internal/app/effects/checks_test.go
@@ -0,0 +1,130 @@
+package effects_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/app/effects"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/domain/change"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/domain/id"
+	"github.com/prathameshk421/flip_the_switch_hackathon/internal/ports"
+)
+
+// checkSarif is a SARIF document with one result at file:line.
+func checkSarif(rule, file string, line int) []byte {
+	doc := map[string]any{"runs": []any{map[string]any{"results": []any{map[string]any{
+		"ruleId": rule, "level": "error", "message": map[string]any{"text": "bad " + rule},
+		"locations": []any{map[string]any{"physicalLocation": map[string]any{
+			"artifactLocation": map[string]any{"uri": file}, "region": map[string]any{"startLine": line, "endLine": line, "snippet": map[string]any{"text": "code " + rule}}}}},
+	}}}}}
+	b, _ := json.Marshal(doc)
+	return b
+}
+
+// sequenceSandbox answers each job from the queue and records the jobs.
+type sequenceSandbox struct {
+	answers []ports.SandboxResult
+	errs    []error
+	jobs    []ports.SandboxJob
+}
+
+func (s *sequenceSandbox) Run(_ context.Context, j ports.SandboxJob) (ports.SandboxResult, error) {
+	i := len(s.jobs)
+	s.jobs = append(s.jobs, j)
+	if i < len(s.errs) && s.errs[i] != nil {
+		return ports.SandboxResult{}, s.errs[i]
+	}
+	return s.answers[i], nil
+}
+
+type profileFake struct {
+	ports.ProfileStore
+	checks []ports.ProfileCheck
+	none   bool
+}
+
+func (p profileFake) ActiveProfile(context.Context, string) (ports.ProfileProposal, bool, error) {
+	return ports.ProfileProposal{Spec: ports.ProfileSpec{Checks: p.checks}}, !p.none, nil
+}
+
+func runChecksFx(t *testing.T, ids ...string) change.Effect {
+	t.Helper()
+	raw, err := json.Marshal(change.RunChecksPayload{Repo: "acme/pay", Change: "PAY-1", Head: "1111111", Base: "2222222", CheckIDs: ids})
+	require.NoError(t, err)
+	return change.Effect{Key: "PAY-1/checks/1111111/r0", Kind: change.EffectRunChecks, Target: "acme/pay", Payload: raw}
+}
+
+func newChecks(t *testing.T, sb *sequenceSandbox, p profileFake) (effects.Checks, *fakeIngest) {
+	t.Helper()
+	ingest := &fakeIngest{}
+	exec, err := effects.NewChecks(effects.ChecksDeps{Source: &fakeSource{}, Sandbox: sb, Profiles: p, Ingest: ingest, IDs: &fakeIDs{}, Clock: fixedClock{}})
+	require.NoError(t, err)
+	return exec, ingest
+}
+
+func reported(t *testing.T, ingest *fakeIngest) change.ChecksReported {
+	t.Helper()
+	require.Len(t, ingest.written, 1)
+	require.Equal(t, change.EventChecksReported, ingest.written[0].Type)
+	var r change.ChecksReported
+	require.NoError(t, json.Unmarshal(ingest.written[0].Payload, &r))
+	return r
+}
+
+// A check with a baseline reports only what the head added: the result the base already had is dropped.
+func TestChecksReportOnlyWhatTheHeadAddedForABaselineCheck(t *testing.T) {
+	old, added := checkSarif("old", "a.go", 3), checkSarif("new", "b.go", 9)
+	both := map[string]any{"runs": []any{
+		json.RawMessage(`{"results":` + resultsOf(t, old) + `}`),
+		json.RawMessage(`{"results":` + resultsOf(t, added) + `}`),
+	}}
+	headSarif, _ := json.Marshal(both)
+	sb := &sequenceSandbox{answers: []ports.SandboxResult{{Sarif: headSarif}, {Sarif: old}}}
+	exec, ingest := newChecks(t, sb, profileFake{checks: []ports.ProfileCheck{{ID: "lint", Lens: "correctness", Baseline: true}}})
+
+	require.NoError(t, exec.Execute(context.Background(), runChecksFx(t, "lint")))
+	got := reported(t, ingest)
+	require.Len(t, got.Results, 1)
+	require.Equal(t, "new", got.Results[0].Rule)
+	require.Equal(t, "lint", got.Results[0].Check)
+	require.Empty(t, got.Errors)
+	require.Len(t, sb.jobs, 2)
+	require.Equal(t, id.SHA("1111111"), sb.jobs[0].SHA)
+	require.Equal(t, id.SHA("2222222"), sb.jobs[1].SHA, "the baseline run is at the base")
+	require.Equal(t, id.SHA("1111111"), sb.jobs[1].Head, "and serves the head it is compared with")
+}
+
+func resultsOf(t *testing.T, doc []byte) string {
+	t.Helper()
+	var d struct {
+		Runs []struct {
+			Results json.RawMessage `json:"results"`
+		} `json:"runs"`
+	}
+	require.NoError(t, json.Unmarshal(doc, &d))
+	return string(d.Runs[0].Results)
+}
+
+// A check that cannot run is an entry of errors and the job is done: the others still report.
+func TestACheckThatCannotRunIsAnErrorEntryNotAFailedJob(t *testing.T) {
+	sb := &sequenceSandbox{errs: []error{errors.New("runner down"), nil}, answers: []ports.SandboxResult{{}, {Sarif: checkSarif("r", "a.go", 1)}}}
+	exec, ingest := newChecks(t, sb, profileFake{checks: []ports.ProfileCheck{{ID: "slow"}, {ID: "lint"}}})
+
+	require.NoError(t, exec.Execute(context.Background(), runChecksFx(t, "slow", "lint", "gone")))
+	got := reported(t, ingest)
+	require.Len(t, got.Results, 1)
+	require.Len(t, got.Errors, 2)
+	require.Equal(t, "slow", got.Errors[0].Check)
+	require.Equal(t, "gone", got.Errors[1].Check)
+	require.Contains(t, got.Errors[1].Reason, "no such check")
+}
+
+func TestARepositoryWithNoPromotedProfileFailsTheJob(t *testing.T) {
+	exec, ingest := newChecks(t, &sequenceSandbox{}, profileFake{none: true})
+	require.Error(t, exec.Execute(context.Background(), runChecksFx(t, "lint")))
+	require.Empty(t, ingest.written)
+}
