{
  "permissions": {
    "allow": [
      "Bash(go:*)", "Bash(gofmt:*)", "Bash(jq:*)",
      "Bash(make fast)", "Bash(make verify)", "Bash(make prototype:*)", "Bash(make lint-selftest)",
      "Bash(make harness-test)", "Bash(make cost)", "Bash(make drift)", "Bash(make e2e:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git branch:*)", "Bash(git switch:*)",
      "Bash(docker ps:*)", "Bash(docker compose:*)", "Bash(docker run:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.switch/**)",
      "Edit(./.claude/**)",
      "Edit(./docs/harness/**)",
      "Edit(./.git/**)",
      "Bash(sudo:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(./.golangci.yml)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./e2e/scenarios/**)",
      "Edit(./e2e/stories/**)",
      "Edit(./testdata/real/**)",
      "Edit(./.github/workflows/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-guard.sh" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh" }]
      }
    ]
  }
}
