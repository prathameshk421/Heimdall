          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0007_refund_note.sql"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2,
                  "snippet": {
                    "text": "ALTER TABLE refunds ADD COLUMN note text NOT NULL;"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
