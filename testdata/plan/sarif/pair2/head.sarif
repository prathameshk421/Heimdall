{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "heimdall-checks",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "oasdiff:removed-endpoint",
          "level": "error",
          "message": {
            "text": "endpoint /healthz was removed from api/openapi.yaml"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "api/openapi.yaml"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 18
                }
              }
            }
          ],
          "properties": {
            "fingerprint": "oasdiff:removed-endpoint:api/openapi.yaml:3333333333333333333333333333333333333333333333333333333333333333"
          }
        }
      ]
    }
  ]
}