{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "heimdall-checks",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "gitleaks:generic-api-key",
          "level": "error",
          "message": {
            "text": "hardcoded fake secret detected"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/legacy/token.go"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 12
                }
              }
            }
          ],
          "properties": {
            "fingerprint": "gitleaks:generic-api-key:internal/legacy/token.go:1111111111111111111111111111111111111111111111111111111111111111"
          }
        }
      ]
    }
  ]
}