{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "auto_mode": true,
  "auto_approve": false,
  "model": "deploy/deepseek-ai/deepseek-v4.1-flash-1017",
  "provider": {
    "deploy": {
      "name": "Deploy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deploy.com/api/v1",
        "apiKey": "{env:DEPLOY_API_KEY}"
      },
      "models": {
        "deepseek-ai/deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 8000
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "deny",
    "external_directory": {
      "*": "deny"
    },
    "edit": {
      "*": "deny",
      "**/scratch/**": "allow"
    },
    "heimdall_*": "allow"
  },
  "mcp": {
    "heimdall": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "headers": {
        "Authorization": "Bearer {{file:secrets/agent_token_reviewer-3}}"
      }
    }
  }
}
