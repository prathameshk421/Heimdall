diff -ruN testdata/reviewbench/heldout/base/internal/delivery/sender.go testdata/reviewbench/heldout/head/internal/delivery/sender.go
--- testdata/reviewbench/heldout/base/internal/delivery/sender.go	2026-11-15 16:54:50.297155832 +0530
+++ testdata/reviewbench/heldout/head/internal/delivery/sender.go	2026-11-15 16:54:50.297338961 +0530
@@ -11,9 +11,12 @@
 func SendWebhook(client *http.Client, url string, payload []byte) error {
 	resp, err := client.Post(url, "application/json", bytes.NewReader(payload))
 	if err != nil {
+		if resp != nil && resp.Body != nil {
+			resp.Body.Close()
+		}
 		return fmt.Errorf("post: %w", err)
 	}
-	defer resp.Body.Close()
+	// BUG G1: resp.Body.Close() removed from success path, leaking sockets in pool
 	_, _ = io.Copy(io.Discard, resp.Body)
 	slog.Info("delivered webhook", "url", url, "status", resp.StatusCode)
 	return nil
